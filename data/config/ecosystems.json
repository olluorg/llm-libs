{
  "$comment": "Экосистемы (реестры пакетов) и поисковые запросы для автоматического обнаружения библиотек. limit — сколько кандидатов брать на запрос.",
  "ecosystems": {
    "pypi": { "language": "Python", "adapter": "pypi", "install": "pip install {name}", "limit": 30 },
    "npm": { "language": "TypeScript", "adapter": "npm", "install": "npm i {name}", "limit": 30 },
    "crates": { "language": "Rust", "adapter": "crates", "install": "cargo add {name}", "limit": 20 },
    "golang": { "language": "Go", "adapter": "golang", "install": "go get {name}", "limit": 20 },
    "maven": { "language": "Java", "adapter": "maven", "install": "mvn:{group}:{artifact}", "limit": 20 },
    "nuget": { "language": "C#", "adapter": "nuget", "install": "dotnet add package {name}", "limit": 20 },
    "rubygems": { "language": "Ruby", "adapter": "rubygems", "install": "gem install {name}", "limit": 15 },
    "packagist": { "language": "PHP", "adapter": "packagist", "install": "composer require {name}", "limit": 15 },
    "hex": { "language": "Elixir", "adapter": "hex", "install": "mix deps.get {name}", "limit": 10 },
    "luarocks": { "language": "Lua", "adapter": "luarocks", "install": "luarocks install {name}", "limit": 10 },
    "cran": { "language": "R", "adapter": "cran", "install": "install.packages('{name}')", "limit": 10 },
    "swift": { "language": "Swift", "adapter": "github", "install": ".package(url: ...)", "limit": 15, "languageFilter": "Swift" },
    "github": { "language": "Other", "adapter": "github", "install": "git clone", "limit": 25, "excludeLanguages": ["JavaScript", "TypeScript", "Python", "Go", "Rust", "Java", "C#", "C++"] }
  },
