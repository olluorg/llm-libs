        "local",
        "chat",
        "streaming",
        "tools",
        "embeddings",
        "vision"
      ],
      "envVars": [
        "OLLAMA_HOST"
      ],
      "repo": "https://github.com/ollama/ollama-python",
      "notes": "Клиент Ollama на Python: chat, generate, embeddings, список/загрузка моделей. Модели: Llama, Qwen, Gemma, Mistral, Phi и др."
    },
    {
